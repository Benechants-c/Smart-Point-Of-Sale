<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/rowRoot"
 android:orientation="horizontal"
 android:padding="12dp"
 android:layout_width="match_parent"
 android:layout_height="wrap_content">
 <TextView android:id="@+id/tvProductName" android:layout_weight="2" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#0F172A"/>
 <TextView android:id="@+id/tvQty" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="13sp"/>
 <TextView android:id="@+id/tvBuy" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="13sp"/>
 <TextView android:id="@+id/tvSell" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="13sp"/>
 <TextView android:id="@+id/tvProfit" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="13sp"/>
 <TextView android:id="@+id/tvStatus" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
